NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/brandguard
JWT_SECRET=replace-this-with-a-long-random-secret
COOKIE_NAME=bg_session
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_REVIEW=false

# Runs only with NODE_ENV=production; set false to disable completely.
# Every 20 minutes while awake, except 01:00–05:00 IST. Cannot wake a sleeping service.
SELF_PING_ENABLED=true
SELF_PING_URL=https://brandguard-bk3c.onrender.com
